{
  "name": "xmoj-electron",
  "private": true,
  "version": "0.0.1",
  "description": "基于 xmoj.tech 的桌面客户端",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "strip-comments": "node scripts/strip-comments.mjs --write",
    "build": "vue-tsc && vite build && electron-builder",
    "build:dir": "vue-tsc && vite build && electron-builder --dir",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types tests/validate.ts",
    "test:poller": "node --experimental-strip-types tests/poller.ts",
    "test:codecheck": "node --experimental-strip-types tests/codecheck.ts",
    "test:diff": "node --experimental-strip-types tests/diff.ts",
    "test:cache": "node --experimental-strip-types --loader ./tests/loader.mjs tests/cache.ts",
    "test:native-views": "node --experimental-strip-types --loader ./tests/loader.mjs tests/native-views.ts",
    "test:cloud-settings": "node --experimental-strip-types --loader ./tests/loader.mjs tests/community-settings.ts",
    "test:markdown": "node --experimental-strip-types --loader ./tests/loader.mjs tests/markdown.ts",
    "test:smoke": "node --experimental-strip-types --loader ./tests/loader.mjs tests/smoke.ts",
    "test:live": "node --experimental-strip-types --loader ./tests/loader.mjs tests/live-login.ts",
    "test:live-community": "node --experimental-strip-types --loader ./tests/loader.mjs tests/live-community.ts",
    "test:live-sources": "node --experimental-strip-types --loader ./tests/loader.mjs tests/live-sources.ts",
    "test:live-judge-api": "node --experimental-strip-types --loader ./tests/loader.mjs tests/live-judge-api.ts",
    "test:compare": "node --experimental-strip-types tests/compare-userscript.ts",
    "test:userscript": "electron tests/userscript-harness.mjs",
    "test:e2e": "electron tests/e2e.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "marked": "^18.1.0",
    "monaco-editor": "^0.53.0",
    "node-html-parser": "^9.0.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.2.2",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vue-tsc": "^2.0.26"
  },
  "main": "dist-electron/main.js",
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  }
}
