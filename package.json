{
  "name": "xmoj-electron",
  "private": true,
  "version": "1.1.1",
  "description": "基于 xmoj.tech 的桌面客户端",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "strip-comments": "node scripts/strip-comments.mjs --write",
    "build": "vue-tsc && vite build && electron-builder",
    "build:dir": "vue-tsc && vite build && electron-builder --dir",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types tests/validate.ts",
    "test:bugfix": "node --experimental-strip-types --loader ./tests/loader.mjs tests/bugfix-regressions.ts",
    "test:parser": "node --experimental-strip-types --loader ./tests/loader.mjs tests/parser-deep.ts",
    "test:mapping": "node --experimental-strip-types --loader ./tests/loader.mjs tests/api-mapping.ts",
    "test:lib": "node --experimental-strip-types --loader ./tests/loader-lib.mjs tests/lib-coverage.ts",
    "test:ipc": "node --experimental-strip-types --loader ./tests/loader.mjs tests/ipc-contract.ts",
    "test:stores": "node --experimental-strip-types --loader ./tests/loader-stores.mjs tests/stores.ts",
    "test:offline": "npm run test && npm run test:bugfix && npm run test:parser && npm run test:mapping && npm run test:lib && npm run test:ipc && npm run test:stores",
    "test:poller": "node --experimental-strip-types tests/poller.ts",
    "test:codecheck": "node --experimental-strip-types tests/codecheck.ts",
    "test:diff": "node --experimental-strip-types tests/diff.ts",
    "test:cache": "node --experimental-strip-types --loader ./tests/loader.mjs tests/cache.ts",
    "test:async-resource": "node --experimental-strip-types tests/async-resource.ts",
    "test:e2e-readiness": "node --test tests/e2e-readiness.test.mjs",
    "test:native-views": "node --experimental-strip-types --loader ./tests/loader.mjs tests/native-views.ts",
    "test:cloud-settings": "node --experimental-strip-types --loader ./tests/loader.mjs tests/community-settings.ts",
    "test:markdown": "node --experimental-strip-types --loader ./tests/loader.mjs tests/markdown.ts",
    "test:markdown-dom": "electron tests/markdown-dom.mjs",
    "test:requested": "node --experimental-strip-types --loader ./tests/loader.mjs tests/requested-regressions.ts",
    "test:followup": "node --experimental-strip-types tests/followup.ts",
    "test:export-discussion": "node --experimental-strip-types tests/export-discussion.ts",
    "test:round3-ui": "electron tests/feature-round3.mjs",
    "test:inline-captcha": "electron tests/inline-captcha.mjs",
    "test:captcha-layout": "node --experimental-strip-types tests/captcha-layout.ts",
    "test:monthly": "node --experimental-strip-types tests/monthly.ts",
    "test:replay": "node --experimental-strip-types tests/replay.ts",
    "test:live-replay": "node --experimental-strip-types tests/live-replay.ts",
    "test:live-replay-ui": "electron tests/live-replay-ui.mjs",
    "test:user-badges": "node --experimental-strip-types tests/user-badges.ts",
    "test:pages": "electron tests/pages.mjs",
    "test:download-progress": "electron tests/download-progress.mjs",
    "test:requested-ui": "electron tests/requested-ui.mjs",
    "test:markdown-copy": "electron tests/markdown-copy.mjs",
    "test:smoke": "node --experimental-strip-types --loader ./tests/loader.mjs tests/smoke.ts",
    "test:live": "node --experimental-strip-types --loader ./tests/loader.mjs tests/live-login.ts",
    "test:live-community": "node --experimental-strip-types --loader ./tests/loader.mjs tests/live-community.ts",
    "test:live-sources": "node --experimental-strip-types --loader ./tests/loader.mjs tests/live-sources.ts",
    "test:live-judge-api": "node --experimental-strip-types --loader ./tests/loader.mjs tests/live-judge-api.ts",
    "test:compare": "node --experimental-strip-types tests/compare-userscript.ts",
    "test:userscript": "electron tests/userscript-harness.mjs",
    "test:e2e": "electron tests/e2e.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "marked": "^18.1.0",
    "monaco-editor": "^0.53.0",
    "node-html-parser": "^9.0.4",
    "prismjs": "^1.30.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^43.8.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.2.2",
    "vite": "^6.4.5",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vue-tsc": "^2.0.26"
  },
  "main": "dist-electron/main.js",
  "overrides": {
    "http-cache-semantics": "^4.3.0",
    "global-agent": "^4.1.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  }
}
